{
  "name": "wyllo-player",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @wyllo/api",
    "dev:web": "npm run dev --workspace @wyllo/web",
    "check": "npm run check --workspace @wyllo/domain && npm run check --workspace @wyllo/api && npm run check --workspace @wyllo/web",
    "test": "npm run test --workspace @wyllo/api",
    "db:migrate": "npm run migrate --workspace @wyllo/api",
    "build": "npm run build --workspace @wyllo/api && npm run build --workspace @wyllo/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  }
}