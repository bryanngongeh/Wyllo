# Local-only credentials. Replace these values for any shared or production deployment.
NODE_ENV=development
POSTGRES_DB=wyllo
POSTGRES_USER=wyllo
POSTGRES_PASSWORD=local_unsafe_dev_only
REDIS_PASSWORD=local_unsafe_dev_only
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
MAL_CLIENT_ID=
# Enable only after verifying written permission covering this app's Jikan use.
ENABLE_JIKAN_METADATA=false
JIKAN_RIGHTS_REVIEW_JSON=
METADATA_PROVIDERS_JSON=
METADATA_API_KEYS_JSON=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
MODULE_CATALOG_PUBLIC_KEY=
MODULE_CATALOG_SIGNATURE=
ALLOW_DEMO_MODULES=false
WEB_HOST_PORT=3000
API_HOST_PORT=4174